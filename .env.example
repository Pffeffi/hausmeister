# LAN-IP des Unraid-Servers (der Port wird nur daran gebunden)
UNRAID_IP=
# Nur noetig, wenn die Unraid-WebGUI nicht auf HTTPS-Port 443 laeuft, z. B. https://192.168.1.10:4444/graphql
# UNRAID_URL=
# Unraid: eigener API-Key, Rechte DOCKER=READ_ANY+UPDATE_ANY, INFO=READ_ANY, ARRAY=READ_ANY (siehe README)
UNRAID_API_KEY=
# Zufaelliges Token, mind. 32 Zeichen (z. B. openssl rand -hex 32). Derselbe Wert kommt auf den Client.
MCP_TOKEN=
# Passwort der Weboberflaeche als scrypt-Hash, erzeugen mit: python hashpw.py
GUI_PASSWORD_HASH=
